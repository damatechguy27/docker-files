# Dagster Database Configuration
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster_password
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_HOST=dagster_postgresql

# Application Database (for your pipelines)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mydb
DATABASE_USER=user
DATABASE_PASSWORD=password

# API Configuration
API_BASE_URL=https://api.example.com
API_KEY=your_api_key_here

# Storage
DATA_PATH=/opt/dagster/app/data
